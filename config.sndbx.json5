// Merge this template into the root sndbx config and set WEBUI_HOST_ROOT to the
// absolute path of this checkout (e.g. /path/to/sndbx/images/open-webui).
{
  sandboxes: {
    items: {
      "open-webui": {
        title: "Open WebUI front end",
        image: "open-webui:latest",
        local_image_id: "open-webui",
        memory: "${WEBUI_MEMORY:-4G}",
        cpus: ${WEBUI_CPUS:-2},
        disk_max: "${WEBUI_DISK_MAX:-20G}",
        persistent: true,
        run_at_startup: false,
        configure_apt_mirror: false,
        ssh_keys: [],
        ssh_user: "openwebui",
        ssh_setup_via_image_hook: true,
        runtime_contract: {
          version: 1,
          environment: {
            WEBUI_BIND_HOST: "${WEBUI_BIND_HOST:-0.0.0.0}",
            WEBUI_PORT: "${WEBUI_PORT:-8080}",
          },
        },
        tmpfs: [
          "/tmp:rw,size=512m",
          "/run:rw,size=64m",
        ],
        shared_directories: [
          {
            host_path: "${WEBUI_HOST_ROOT}/data",
            guest_path: "/app/backend/data",
            mount_type: "dir",
            source_type: "directory",
            permission: "rw",
            required: true,
            create_if_missing: true,
          },
          {
            host_path: "${WEBUI_HOST_ROOT}/.env",
            guest_path: "/app/backend/data/.env",
            mount_type: "file",
            source_type: "file",
            permission: "ro",
            required: false,
          },
        ],
        port_bindings: [
          {
            bind_host: "${WEBUI_SSH_BIND_HOST:-0.0.0.0}",
            vm_port: 22,
            publish_port: ${WEBUI_SSH_HOST_PORT:-15021},
          },
          {
            bind_host: "${WEBUI_BIND_HOST:-0.0.0.0}",
            vm_port: 8080,
            publish_port: ${WEBUI_HOST_PORT:-15080},
          },
        ],
      },
    },
  },
  envids: {
    "open-webui-env-token": {
      sandbox: "open-webui",
      description: "Open WebUI environment",
    },
  },
}
