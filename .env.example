# Copy this file to .env before starting Open WebUI. Keep .env private and use
# shell-compatible KEY=value entries only.
#
# This example is tracked by Git: keep environment-specific addresses, ports,
# and secrets out of it and set the real values in .env instead.

# Runtime identity. Set these to the UID/GID of the user that runs sndbx
# (see `id -u` / `id -g`) so files created under data/ belong to that user.
# The container remaps its internal openwebui account at startup.
WEBUI_UID=1000
WEBUI_GID=1000

# Server bind and published ports. WEBUI_BIND_HOST also controls the host
# interface the UI is published on. WEBUI_PORT is the in-container port.
WEBUI_BIND_HOST=0.0.0.0
WEBUI_PORT=8080
WEBUI_HOST_PORT=15080

# SSH publication used by sndbx (guest port 22).
WEBUI_SSH_BIND_HOST=0.0.0.0
WEBUI_SSH_HOST_PORT=15021

# Session signing secret. Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=replace-with-a-long-random-secret

# External service to connect to (any OpenAI- or Ollama-compatible endpoint).
# Set the real host and port in .env, not here. The launcher derives the
# OpenAI-compatible endpoint (<base>/v1) and the Ollama-compatible endpoint
# (<base>) from this value.
EXTERNAL_API_BASE_URL=http://llm-host:PORT
# Optional bearer token for the external service; anonymous use is allowed when empty.
EXTERNAL_API_KEY=none

# Optional explicit overrides for the derived connection settings.
# OPENAI_API_BASE_URLS=
# OPENAI_API_KEYS=
# OLLAMA_BASE_URL=
# ENABLE_OPENAI_API=true
# ENABLE_OLLAMA_API=true

# Runtime.
TZ=UTC
